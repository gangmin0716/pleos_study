<?xml version="1.0" encoding="utf-8"?>
<!-- Pleos ivi_basic_button Type=Primary, Size=Small -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_basic_pressed" />
            <corners android:radius="@dimen/radius_button_small" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_basic_enabled" />
            <corners android:radius="@dimen/radius_button_small" />
        </shape>
    </item>
</selector>
