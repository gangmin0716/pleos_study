<?xml version="1.0" encoding="utf-8"?>
<!-- Immersive now-playing card: the album art, heavily blurred, is the card's ground, and
     everything on it uses the Pleos static/light colours -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/musicCard"
    style="@style/Card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_fallback"
    android:padding="0dp">

    <ImageView
        android:id="@+id/musicBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_music_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_07">

        <!-- Album art stays square and follows the card height -->
        <com.example.pleos_study.SquareFrameLayout
            android:id="@+id/musicArtFrame"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_art_placeholder"
            android:elevation="16dp"
            android:outlineSpotShadowColor="#66000000">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_music_note"
                app:tint="@color/static_light_400" />

            <ImageView
                android:id="@+id/musicArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </com.example.pleos_study.SquareFrameLayout>

        <LinearLayout
            android:id="@+id/musicInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Where the music comes from: the app's name, or 블루투스 for a phone -->
            <TextView
                android:id="@+id/musicSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/static_light_300"
                android:textSize="28sp"
                android:visibility="gone"
                tools:text="Spotify"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/musicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/music_idle_title"
                android:textColor="@color/static_light_100"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/musicArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/music_idle_subtitle"
                android:textColor="@color/static_light_200"
                android:textSize="32sp" />

            <com.example.pleos_study.BarView
                android:id="@+id/musicProgress"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="28dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/musicElapsed"
                    style="@style/MediaTime"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    tools:text="3:02" />

                <TextView
                    android:id="@+id/musicRemaining"
                    style="@style/MediaTime"
                    android:layout_width="wrap_content"
                    tools:text="-0:00" />
            </LinearLayout>

            <!-- Transport row, spread across the width like the progress bar above it -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/musicShuffle"
                    style="@style/MediaGlyph"
                    android:contentDescription="@string/music_shuffle"
                    android:src="@drawable/ic_media_shuffle" />

                <Space style="@style/MediaGap" />

                <ImageButton
                    android:id="@+id/musicPrev"
                    style="@style/MediaGlyph.Large"
                    android:contentDescription="@string/music_prev"
                    android:src="@drawable/ic_media_prev" />

                <Space style="@style/MediaGap" />

                <ImageButton
                    android:id="@+id/musicPlayPause"
                    style="@style/MediaGlyph.Large"
                    android:contentDescription="@string/music_play_pause"
                    android:src="@drawable/ic_play" />

                <Space style="@style/MediaGap" />

                <ImageButton
                    android:id="@+id/musicNext"
                    style="@style/MediaGlyph.Large"
                    android:contentDescription="@string/music_next"
                    android:src="@drawable/ic_media_next" />

                <Space style="@style/MediaGap" />

                <ImageButton
                    android:id="@+id/musicRepeat"
                    style="@style/MediaGlyph"
                    android:contentDescription="@string/music_repeat"
                    android:src="@drawable/ic_media_repeat" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
