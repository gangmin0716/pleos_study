<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pleos_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top bar: pedals on the left, session and connection on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_small_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/PedalLabel"
            android:text="@string/throttle" />

        <com.example.pleos_study.BarView
            android:id="@+id/throttleBar"
            style="@style/PedalBar" />

        <TextView
            style="@style/PedalLabel"
            android:layout_marginStart="32dp"
            android:text="@string/brake" />

        <com.example.pleos_study.BarView
            android:id="@+id/brakeBar"
            style="@style/PedalBar" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/sessionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="720dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/session_waiting"
            android:textColor="@color/text_dark_tertiary"
            android:textSize="28sp" />

        <View
            android:id="@+id/statusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_status_dot" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/status_waiting"
            android:textColor="@color/text_dark_primary"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/resetLayoutButton"
            style="@style/BarButton"
            android:layout_marginStart="24dp"
            android:drawableStart="@drawable/ic_pleos_refresh"
            android:drawableTint="@color/text_dark_primary"
            android:text="@string/layout_reset"
            android:visibility="gone" />

        <TextView
            android:id="@+id/editLayoutButton"
            style="@style/BarButton"
            android:layout_marginStart="12dp"
            android:text="@string/layout_edit" />
    </LinearLayout>

    <!-- Cards are placed from assets/dashboard_grid.json -->
    <com.example.pleos_study.DashboardGridLayout
        android:id="@+id/dashboardGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1" />
</LinearLayout>
