<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.example.pleos_study.RpmGaugeView
                android:id="@+id/rpmGauge"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.example.pleos_study.GearIndicatorView
                android:id="@+id/gearIndicator"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Traction control and ABS telltales (Pleos driving view icons), lit while they intervene -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tcTelltale"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/telltale_tc"
                android:src="@drawable/ic_pleos_tcs" />

            <ImageView
                android:id="@+id/absTelltale"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/telltale_abs"
                android:src="@drawable/ic_pleos_abs" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
